{
  "editionId": "princess-rosie-production",
  "title": "Princess Rosie and the Seven Birthday Stars",
  "locale": "en",
  "storybookStage": {
    "width": 1280,
    "height": 720,
    "cropEssentialContent": false
  },
  "playerAction": {
    "pressed": "rise",
    "released": "settle",
    "bindings": ["keyboard.space", "pointer.primary"],
    "overlapPolicy": "shared-held-action"
  },
  "openingMoments": [
    {
      "id": "opening.celebration-preparations",
      "eyebrow": "Once upon a birthday…",
      "title": "A celebration across the sea",
      "copy": "Far across the sparkling Sapphire Sea, Princess Zélie’s very first birthday celebration was almost ready. Gigi hung roses and ribbons from every golden arch.",
      "illustration": "opening.celebration-preparations",
      "semanticCheckpoint": {
        "celebrationPreparationHost": "Gigi"
      }
    },
    {
      "id": "opening.scattered-stars",
      "eyebrow": "Then—WHOOSH!",
      "title": "Seven Stars flew away",
      "copy": "A playful wind scattered seven Birthday Stars across Fairytale Sicily. The Rainbow Paths to the Birthday Castle vanished!",
      "illustration": "opening.scattered-stars",
      "semanticCheckpoint": {
        "birthdayStarCount": 7
      }
    },
    {
      "id": "opening.departure",
      "eyebrow": "A brave big sister",
      "title": "Rosie and Stella can help",
      "copy": "Princess Rosie climbed onto Stella, her flying unicorn. “We’ll find every Star and bring everyone to the celebration!”",
      "illustration": "opening.rosie-stella-departure",
      "semanticCheckpoint": {
        "promiseKeepers": ["Princess Rosie", "Stella"]
      }
    }
  ],
  "initialFlight": {
    "background": "flight.rose-garden-background",
    "character": "flight.rosie-stella"
  },
  "places": [
    {
      "id": "lacewood",
      "name": "Zélie’s Lacewood",
      "familyGuest": "Gram",
      "playfulBumpKind": "silver-ribbon",
