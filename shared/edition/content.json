      "singleRoute": {
        "id": "single-route.lacewood",
        "interactions": [
          {
            "id": "silver-ribbons",
            "name": "Silver ribbons",
            "altitudeBand": "high",
            "visualResponse": "silver-ribbons-unfurl"
          },
          {
            "id": "rose-lights",
            "name": "Rose lights",
            "altitudeBand": "low",
            "visualResponse": "rose-lights-bloom"
          }
        ],
        "birthdayStarMoment": "Gram followed the silver ribbons and glowing roses through Zélie’s Lacewood!",
        "celebrationEcho": "silver-ribbons-and-rose-lights"
      },
      "birthdayStar": "birthday-star.lacewood",
      "rainbowPath": "rainbow-path.lacewood"
    },
    {
