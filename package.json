{
  "name": "princess-rosie-editions",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/phaser-original",
    "tools/edition-contract"
  ],
  "scripts": {
    "dev": "npm run dev --workspace princess-rosie-phaser-original",
    "build": "npm run build --workspace princess-rosie-phaser-original",
    "preview": "npm run preview --workspace princess-rosie-phaser-original",
    "test": "npm run test --workspace princess-rosie-phaser-original",
    "test:contract": "npm run test --workspace rosie-edition-contract",
    "test:e2e": "npm run test:e2e --workspace princess-rosie-phaser-original",
    "test:e2e:install": "npm run test:e2e:install --workspace princess-rosie-phaser-original",
    "check": "npm run test:contract && npm run check --workspace princess-rosie-phaser-original"
  }
}
