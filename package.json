{
  "name": "princess-rosie-editions",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "tools/soundscape-build"
  ],
  "scripts": {
    "dev": "npm run dev --workspace princess-rosie-web",
    "build": "npm run build --workspace princess-rosie-web",
    "preview": "npm run preview --workspace princess-rosie-web",
    "test": "npm run test --workspace princess-rosie-web",
    "test:soundscape-build": "npm run test --workspace rosie-soundscape-build",
    "test:godot": "apps/godot/tests/run_acceptance.sh",
    "soundscape:build": "npm run build --workspace rosie-soundscape-build --",
    "soundscape:build-confirmation": "npm run build:confirmation --workspace rosie-soundscape-build --",
    "soundscape:media-docs": "npm run media-docs --workspace rosie-soundscape-build --",
    "soundscape:remaster": "npm run remaster --workspace rosie-soundscape-build --",
    "soundscape:validate": "npm run validate --workspace rosie-soundscape-build --",
    "test:e2e": "npm run test:e2e --workspace princess-rosie-web",
    "test:e2e:install": "npm run test:e2e:install --workspace princess-rosie-web",
    "check": "npm run typecheck --workspace rosie-soundscape-build && npm run test:soundscape-build && npm run check --workspace princess-rosie-web"
  }
}
