; Princess Rosie and the Seven Birthday Stars — Godot Production Edition
; This project intentionally targets the exact Godot 4.7.2 Forward+ baseline.

config_version=5

[application]

config/name="Princess Rosie and the Seven Birthday Stars"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/storybook_shell.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[input]

pause_presentation={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305,"unicode":27)]
}

[rendering]

textures/vram_compression/import_etc2_astc=true
